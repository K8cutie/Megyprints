{
  "expo": {
    "name": "Megy Prints 2.0 (dev)",
    "slug": "megyprints-2",
    "version": "2.0.9",
    "scheme": "megyprints-dev",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.megyprints.app.dev",
      "versionCode": 109,
      "adaptiveIcon": {
        "backgroundColor": "#B85C38",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.megyprints.app.dev",
      "buildNumber": "109",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "./plugins/withShortCmakeObjectPaths",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": false,
          "photosPermission": "Megy Prints shows your photos so you can pick the ones for your album.",
          "savePhotosPermission": false,
          "preventAutomaticLimitedAccessAlert": true
        }
      ],
      "expo-image",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": false
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
