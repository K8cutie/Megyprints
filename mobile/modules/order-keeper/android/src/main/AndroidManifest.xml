<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The order keeper (OrderKeeperService): keeps Place order going while
       the person uses other apps, with a notification showing the bar. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Keeps the processor awake while an order is sent (the screen may go dark). -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name="expo.modules.megyorderkeeper.OrderKeeperService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
  </application>
</manifest>
