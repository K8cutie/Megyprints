node_modules
dist
.DS_Store

# Environment files / secrets — never commit (matches .env at any depth;
# .env.example templates are a different name and stay committable)
.env
.env.local
.env.*.local

# Local safety snapshots created before edits
_backups/

# Personal Claude Code permission overrides (machine-local)
.claude/settings.local.json

# Backup copies and archives — not source
src - Copy/
src - Copy (2)/
*.zip

# Android (TWA) signing + build outputs — the keystore and its passwords must
# never land in git; backup lives in Documents\megyprints-signing
android/*.keystore
android/signing.local.txt
android/.gradle/
android/build/
android/app/build/
android/*.apk
android/*.aab
android/*.idsig
