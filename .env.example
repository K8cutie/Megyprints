# Root env — read by docker-compose for ${VAR} substitution. GITIGNORED.
# Holds the frontend's public build args + the DB credentials for compose.
# (Backend app secrets live in backend/.env — see backend/.env.example.)

# Frontend (public — baked into the static build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER-ONLY. Never expose this to the browser and never prefix it with VITE_.
# Used by api/delete-account.mjs for exactly one thing: removing a deleting
# customer's print PDFs from the private bucket. The customer's own session
# cannot do it — the Storage API looks an object up before deleting it, and
# migration 0008 denies customers SELECT on print-pdfs so a paid album can't be
# downloaded. Everything else in that endpoint runs as the CUSTOMER.
# Without it, account deletion refuses rather than deleting the account and
# leaving the photos behind. Set it in Vercel → Project → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Error monitoring (OPTIONAL — both are no-ops when unset).
# VITE_SENTRY_DSN: publishable client DSN from sentry.io (safe to ship, like the
#   anon key). Turns on Sentry error capture. See docs/MONITORING-ACTIVATION.md.
#   NOTE: if you pick a non-US Sentry region, add its ingest host to connect-src
#   in vercel.json (US + generic hosts are already allowlisted).
# VITE_ERROR_ENDPOINT: optional extra sink (webhook/collector) errors are POSTed to.
VITE_SENTRY_DSN=
VITE_ERROR_ENDPOINT=

# Postgres credentials (used by the postgres + backend services)
POSTGRES_USER=megyuser
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=megyprints
