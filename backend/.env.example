# Backend secrets — copy to backend/.env and fill in real values.
# (backend/.env is gitignored; this template is committed.)
JWT_SECRET=change-me-to-a-long-random-secret
FRONTEND_URL=http://localhost
PORT=4000

# Supabase — for the operator/admin routes.
# SERVICE ROLE KEY bypasses RLS: server-only, NEVER ship it to the browser.
# Find both in Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed to use the operator/admin API.
STAFF_EMAILS=owner@megyprints.com
