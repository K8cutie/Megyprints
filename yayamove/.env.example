# ─────────────────────────────────────────────────────────────────────────────
# Yayamove environment — copy to `.env` and fill in. NEVER commit `.env`.
#
# The anon/publishable key is PUBLIC by design (it ships in the frontend bundle).
# Row-Level Security in Postgres is the ONLY thing protecting your data — see
# supabase/migrations/0002_rls_lockdown.sql. Do NOT put the service_role key here;
# it must only ever live in Supabase Edge Function secrets, never in the client.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-publishable-key
